BEGIN:VEVENT
UID:tinos-tinos-chora-dormition-of-the-virgin-at-panagia-evangelistria-2027@aegeanblueprint.com
DTSTAMP:20260902T000000Z
DTSTART;VALUE=DATE:20270814
DTEND;VALUE=DATE:20270816
SUMMARY:Dormition of the Virgin at Panagia Evangelistria\, Chora
LOCATION:Tinos Chora\, Tinos\, Greece
DESCRIPTION:The largest religious pilgrimage in Greece. Pilgrims crawl the kilometre from the port to the Church of Panagia Evangelistria on hands and knees. Book accommodation months in advance.\n\nhttps://aegeanblueprint.com/festivals/tinos/#tinos-chora-dormition-of-the-virgin-at-panagia-evangelistria
URL:https://aegeanblueprint.com/festivals/tinos/#tinos-chora-dormition-of-the-virgin-at-panagia-evangelistria
END:VEVENT
